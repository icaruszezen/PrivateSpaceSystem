{
  "name": "private-space-system",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted AES-256-GCM encrypted private space for text notes, passwords, images, and videos with Web/Android/iOS sync",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:client": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:mobile && npm run build:server",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:test": "npm run android:sync && cd mobile/android && ./gradlew testDebugUnitTest",
    "android:apk": "npm run android:sync && cd mobile/android && ./gradlew assembleDebug",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p mobile/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "dompurify": "^3.2.4",
    "hono": "^4.7.4",
    "lucide-react": "^0.487.0",
    "marked": "^15.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  }
}
