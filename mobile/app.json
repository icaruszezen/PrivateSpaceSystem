{
  "expo": {
    "name": "PSS",
    "slug": "pss-mobile",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F5F0",
    "primaryColor": "#1F4A40",
    "ios": {
      "bundleIdentifier": "io.privatespace.ios",
      "buildNumber": "500",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "使用面容 ID 快速完成 PSS 会话验证与凭据自动填充。",
        "NSPhotoLibraryUsageDescription": "选择图片或视频文件以同步至您的 PSS 自托管服务节点。",
        "NSPhotoLibraryAddUsageDescription": "将 PSS 同步文件导出保存至系统媒体库。"
      },
      "entitlements": {
        "com.apple.developer.authentication-services.autofill-credential-provider": true,
        "com.apple.security.application-groups": ["group.io.privatespace.ios"]
      }
    },
    "android": {
      "package": "io.privatespace.android"
    }
  }
}
