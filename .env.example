# 服务监听端口（宿主机映射端口）
PORT=8080

# 私密空间默认显示名称
VAULT_NAME=PrivateSpace

# 可选（推荐留空以获得严格端到端零知识保证）：
# 留空时，首次打开网页或手机 App 将在客户端本地生成 256 位随机主密钥 DEK，服务器永远不会接触主密码。
# 若设置非空值（至少 8 位）用于自动化无头首启，进程会在首次生成兼容 E2EE v2 信封后立即擦除内存与环境变量（请随后从宿主机 .env 中删除该明文项）。
ADMIN_PASSWORD=

# 盲会话令牌有效期（小时，服务端会话表不保存任何解密密钥）
SESSION_TTL_HOURS=72

# 若通过 HTTPS 域名访问，建议开启 Secure Cookie
COOKIE_SECURE=false

# 可选：允许跨域访问的移动端/桌面端来源（逗号分隔）
CORS_ORIGINS=

# 可选：iOS 原生端 Associated Domains 签名标识（TeamID.BundleID，用于系统密码自动填充与通用链接）
APPLE_APP_ID=TEAMID.io.privatespace.ios
