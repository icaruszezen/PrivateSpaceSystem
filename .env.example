# 服务监听端口（宿主机映射端口）
PORT=8080

# 私密空间默认显示名称
VAULT_NAME=PrivateSpace

# 可选（推荐留空以获得严格端到端零知识保证）：
# 留空时，首次打开网页或手机 App 将在客户端本地生成 256 位随机主密钥 DEK，服务器永远不会接触主密码。
# 若设置非空值（至少 8 位）用于自动化无头首启，进程会在首次生成兼容 E2EE v2 信封后立即擦除内存与环境变量（请随后从宿主机 .env 中删除该明文项）。
ADMIN_PASSWORD=

# 盲会话令牌有效期（小时，服务端会话表不保存任何解密密钥）
SESSION_TTL_HOURS=72

# 若通过 HTTPS 域名访问，建议开启 Secure Cookie
COOKIE_SECURE=false

# 可选：允许跨域访问的移动端/桌面端来源（逗号分隔）
CORS_ORIGINS=

# 可选：iOS 原生端 Associated Domains 签名标识（TeamID.BundleID，用于系统密码自动填充与通用链接）
APPLE_APP_ID=TEAMID.io.privatespace.ios

# ==================== Android / iOS 软件自动更新与 GitHub Releases 参数 ====================

# 绑定的 GitHub 软件发布仓库（格式：owner/repo）
GITHUB_REPO=icaruszezen/PrivateSpaceSystem

# GitHub REST API 基础地址（GitHub Enterprise 可改为企业实例地址）
GITHUB_API_BASE_URL=https://api.github.com

# 可选：GitHub Fine-grained PAT（仅当 GITHUB_REPO 为私有仓库，或需提升 API 频率上限至 5000 次/小时时配置；仅需 Contents: Read-only 权限）
GITHUB_TOKEN=

# 默认更新通道：stable（仅正式 Release）或 beta（包含 Pre-release 预览版）
UPDATE_CHANNEL=stable

# 服务端缓存 GitHub Releases 元数据的秒数（默认 300 秒）
UPDATE_CACHE_TTL_SECONDS=300

# Android 包名与最低强制兼容版本（当客户端版本低于 ANDROID_MIN_SUPPORTED_VERSION 时将触发强制升级弹窗）
ANDROID_APPLICATION_ID=com.privatespace.mobile
ANDROID_MIN_SUPPORTED_VERSION=

# iOS Bundle ID、最低强制兼容版本及分发渠道参数（支持 App Store / TestFlight / 企业或 Ad-Hoc OTA 清单）
IOS_BUNDLE_ID=io.privatespace.ios
IOS_MIN_SUPPORTED_VERSION=
IOS_APP_STORE_ID=
IOS_TESTFLIGHT_URL=
# 可选：自定义 HTTPS Apple OTA manifest.plist 地址；留空时服务端自动在 /api/v1/updates/ios-manifest.plist 动态生成
IOS_OTA_MANIFEST_URL=
